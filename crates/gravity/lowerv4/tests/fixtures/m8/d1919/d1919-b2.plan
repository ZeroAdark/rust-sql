-- name: d1919-b2
-- sql: SELECT count(*), sum(t.id), sum(s.mid), sum(s.nid), sum(x2.id), min(x2.x) FROM d19w t CROSS JOIN LATERAL (SELECT m.id AS mid, n.id AS nid FROM d19m m JOIN (SELECT * FROM d19w WHERE id BETWEEN 100 AND 104) n ON n.k < m.k WHERE m.k = t.k OFFSET 0) s JOIN d19w x2 ON x2.x > t.x + 1990 WHERE t.id < 6 AND x2.id > 1994;
