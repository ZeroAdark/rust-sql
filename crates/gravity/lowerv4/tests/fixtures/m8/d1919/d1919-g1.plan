-- sql: SELECT count(*), sum(g.mx), sum(u.id), sum(x2.id) FROM (SELECT k, max(id) AS mx FROM d19m GROUP BY k) g JOIN d19w u ON u.id = g.mx JOIN (SELECT * FROM d19w WHERE id > 1995) x2 ON x2.k < u.k;
