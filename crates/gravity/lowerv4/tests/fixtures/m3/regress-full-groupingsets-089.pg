# PostgreSQL 18.6 (Ubuntu 18.6-1.pgdg24.04+2, box 17, M3-L1 09-25): COPY (<sql>) TO STDOUT over a fresh initdb
sql: select distinct a, b, c from (values (1, 2, 3), (4, null, 6), (7, 8, 9)) as t (a, b, c) group by rollup(a, b), rollup(a, c) order by a, b, c;
