# PostgreSQL 18.6 (Ubuntu 18.6-1.pgdg24.04+2) (M7-RIG m7x table-free join rows): COPY (<sql>) TO STDOUT over a fresh initdb + the corpus's setup
sql: SELECT a.x, b.y, c.w, d.v FROM (SELECT g % 10 AS x FROM generate_series(1, 30) g) a LEFT JOIN (VALUES (1, 1), (2, 2), (2, 2), (3, NULL)) b(y, m) ON a.x = b.y JOIN (VALUES (1, 100), (2, 200), (2, 201)) c(n, w) ON b.m = c.n LEFT JOIN (VALUES (1, 7), (5, 8)) d(u, v) ON c.n = d.u
