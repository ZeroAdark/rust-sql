# PostgreSQL 18.6 (Ubuntu 18.6-1.pgdg24.04+2) (M7-RIG m7x table-free join rows): COPY (<sql>) TO STDOUT over a fresh initdb + the corpus's setup
sql: SELECT a.x FROM (SELECT CASE WHEN g % 7 = 0 THEN NULL ELSE g % 9 END AS x FROM generate_series(1, 50) g) a WHERE NOT EXISTS (SELECT 1 FROM (VALUES (2), (2), (3), (NULL), (5)) b(y) WHERE b.y = a.x)
