  project (1=outer.1, 2=agg2108!distinct(1=outer.2) filter op641(io25(outer.2), c25:'123'), 3j=c23:0, 4j=outer.1)
  append arm 0/2
  sort keys=3+:I32,4+:I32 form=runs
  outs 1=w4:val 2=w8:val 3=w4:val 4=w4:val
