  project (1=c23:null, 2=agg2108!distinct(1=outer.2) filter op641(io25(outer.2), c25:'123'), 3j=c23:1, 4j=c23:null)
  append arm 1/2
  sort keys=3+:I32,4+:I32 form=runs
  outs 1=w4:val 2=w8:val 3=w4:val 4=w4:val
p4 node=0 serial site=-1 reason=NoDrivingSite end=sink
  desc consumes=slot2@p3
  nodes n0@0
  source breaker slot=2
  project (1=outer.1, 2=outer.2)
  outs 1=w4:val 2=w8:val
