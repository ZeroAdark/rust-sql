-- regress-full-sysviews-003
-- select type, name, ident, level, total_bytes >= free_bytes from pg_backend_memory_contexts where level = 1;
graph pipelines=1 breakers=0 init_plans=0 root=p0
p0 node=0 serial site=-1 reason=NoDrivingSite end=sink
  nodes n0@0
  source const
  srf from rti=2 [1:Other fn2282 cols=10 fn2282()]
  filter op96(v2.4, c23:1)
  project (1=v2.3, 2=v2.1, 3=v2.2, 4=v2.4, 5=op415(v2.6, v2.8))
  outs 1=vl:row 2=vl:row 3=vl:row 4=w4:val 5=w1:val
mapped: FunctionScan
