-- regress-full-select_parallel-045
-- select parallel_workers_to_launch > '0' AS wrk_to_launch, parallel_workers_launched > '0' AS wrk_launched from pg_stat_database where datname = current_database();
graph pipelines=2 breakers=0 init_plans=0 root=p1
p0 node=3 serial site=-1 reason=NoDrivingSite end=sink
  nodes n3@0 n2@2 n1@3 n0@5
  source const
  gate T_List
  project (1=c23:0, 2=c19:null)
  project (1=relabel26(c23:0), 2=c19:null)
  append arm 0/2
  project (1=outer.1, 2=outer.2)
  project (1=op413(fn6355(v2.1), c20:0), 2=op413(fn6356(v2.1), c20:0))
  outs 1=w4:val 2=fx64:stmt/imm
  outs 1=w4:val 2=fx64:stmt/imm
  outs 1=w4:val 2=fx64:life/breaker
  outs 1=w1:val 2=w1:val
p1 node=5 eligible rows=1 end=sink
  nodes n5@0 n1@2 n0@4
  source range rel=1262 rti=6 am=heap
    lanes Attr(1):byval8:w8:val Attr(2):byref8:fx64:win/page Offset:byval2:w2:val
  filter op93(v6.2, fn861())
  project (1=v6.1, 2=v6.2)
  append arm 1/2
  project (1=outer.1, 2=outer.2)
  project (1=op413(fn6355(v2.1), c20:0), 2=op413(fn6356(v2.1), c20:0))
  outs 1=w8:val 2=fx64:win/page
  outs 1=w4:val 2=fx64:life/breaker
  outs 1=w1:val 2=w1:val
