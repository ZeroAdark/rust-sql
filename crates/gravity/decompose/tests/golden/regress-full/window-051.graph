-- regress-full-window-051
-- select x, y, first_value(y) over w, last_value(y) over w from (select x, x as y from generate_series(1,5) as x union all select null, 42 union all select null, 43) ss window w as (order by x asc nulls first range between 2 preceding and 2 following);
graph pipelines=5 breakers=4 init_plans=0 root=p4
p0 node=3 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Sort)
  nodes n3@0 n2@2 n1@4^
  source const
  srf from rti=5 [1:SeriesInt { width: 4, step: false } fn1067 fn1067(c23:1, c23:5)]
  project (1=v5.1, 2=v5.1)
  append arm 0/3
  project (1=outer.1, 2=outer.2)
  sort keys=1+n:I32 form=runs
  outs 1=w4:val 2=w4:val
  outs 1=w4:val 2=w4:val
p1 node=4 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Sort)
  nodes n4@0 n2@1 n1@3^
  source const
  project (1=c23:null, 2=c23:42)
  append arm 1/3
  project (1=outer.1, 2=outer.2)
  sort keys=1+n:I32 form=runs
  outs 1=w4:val 2=w4:val
  outs 1=w4:val 2=w4:val
p2 node=5 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Sort)
  nodes n5@0 n2@1 n1@3^
  source const
  project (1=c23:null, 2=c23:43)
