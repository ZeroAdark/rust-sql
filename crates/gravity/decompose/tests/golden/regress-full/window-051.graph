  outs 1=w4:val 2=w4:val
p3 node=1 serial site=-1 reason=NoDrivingSite end=breaker(slot=1 Materialize)
  desc consumes=slot0@p2
  nodes n1@0 n0@1^
  source breaker slot=0
  project (1=outer.1, 2=outer.2)
  outs 1=w4:val 2=w4:val
p4 node=0 serial site=-1 reason=NoDrivingSite end=sink
  desc consumes=slot1@p3
  nodes n0@0
  source breaker slot=1
  window ref=1 top partition= order=1=96:I32 frame=Range c23:2-preceding..c23:2-following
