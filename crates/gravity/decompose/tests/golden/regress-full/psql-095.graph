-- regress-full-psql-095
-- SELECT n.nspname AS "Schema", c.collname AS "Name", CASE c.collprovider WHEN 'd' THEN 'default' WHEN 'b' THEN 'builtin' WHEN 'c' THEN 'libc' WHEN 'i' THEN 'icu' END AS "Provider", c.collcollate AS "Collate", c.collctype AS "Ctype", c.colllocale AS "Locale", c.collicurules AS "ICU Rules", CASE WHEN c.collisdeterministic THEN 'yes' ELSE 'no' END AS "Deterministic?" FROM pg_catalog.pg_collation c, pg_catalog.pg_namespace n WHERE n.oid = c.collnamespace AND c.collencoding IN (-1, pg_catalog.pg_char_to_encoding(pg_catalog.getdatabaseencoding())) AND c.collname OPERATOR(pg_catalog.~) E'^(no\\.such\\.collation)$' COLLATE pg_catalog.default AND n.nspname OPERATOR(pg_catalog.~) E'^(no\\.such\\.schema)$' COLLATE pg_catalog.default ORDER BY 1, 2;
graph pipelines=3 breakers=2 init_plans=0 root=p2
p0 node=3 eligible rows=1 end=breaker(slot=0 HashBuild)
  desc words=bits@5/6
  nodes n3@0 n1@2^
  source range rel=2615 rti=2 am=heap
    lanes Attr(1):byval8:w8:val Attr(2):byref8:fx64:win/page Offset:byval2:w2:val
  filter op639(v2.2, c25:'^(no\.such\.schema)$')
  project (1=v2.1, 2=v2.2, 3=v2.3, 4=v2.4)
  build keys=(outer.1) decls=26/26:I32
  outs 1=w8:val 2=fx64:win/page 3=w4:val 4=vl:row
p1 node=2 serial site=0 reason=IndexSource end=breaker(slot=1 Sort)
  desc consumes=slot0@p0
  nodes n2@0 n1@2 n0@4^
  source index rel=3456 rti=1 am=heap index=3164
    key att=2 op=254 value=c25:'no.such.collation'
    key att=7 op=96 form=any value=array(c23:-1, fn1264(fn1039()))
    recheck (op254(v1.2, c25:'no.such.collation'), any96(v1.7, array(c23:-1, fn1264(fn1039()))))
    lanes Attr(2):byref8:fx64:win/page Attr(3):byval8:w8:val Attr(5):byval8:w8:val Attr(6):byval8:w8:val Attr(8):byref8:vl:win/page Attr(9):byref8:vl:win/page Attr(10):byref8:vl:win/page Attr(11):byref8:vl:win/page
  filter op639(v1.2, c25:'^(no\.such\.collation)$')
  project (1=v1.1, 2=v1.2, 3=v1.3, 4=v1.4, 5=v1.5, 6=v1.6, 7=v1.7, 8=v1.8, 9=v1.9, 10=v1.10, 11=v1.11, 12=v1.12)
  probe slot=0 inner=n3 JOIN_INNER unique catalog keys=(outer.3) decls=26/26:I32 clauses=(op607(outer.3, inner.1))
  project (1=inner.2, 2=outer.2, 3=case[outer.5](when op92(T_CaseTestExpr, c18:100) then c25:'default', when op92(T_CaseTestExpr, c18:98) then c25:'builtin', when op92(T_CaseTestExpr, c18:99) then c25:'libc', when op92(T_CaseTestExpr, c18:105) then c25:'icu') else c25:null, 4=outer.8, 5=outer.9, 6=outer.10, 7=outer.11, 8=case(when outer.6 then c25:'yes') else c25:'no')
  sort keys=1+:Fp128@950#19,2+:Fp128@950#19 form=runs
  outs 1=w4:val 2=fx64:win/page 3=w8:val 4=w4:val 5=w8:val 6=w8:val 7=w4:val 8=vl:win/page 9=vl:win/page 10=vl:win/page 11=vl:win/page 12=vl:row
  outs 1=fx64:life/breaker 2=fx64:win/page 3=vl:stmt/imm 4=vl:win/page 5=vl:win/page 6=vl:win/page 7=vl:win/page 8=vl:stmt/imm
p2 node=0 serial site=-1 reason=NoDrivingSite end=sink
  desc consumes=slot1@p1
  nodes n0@0
  source breaker slot=1
  project (1=outer.1, 2=outer.2, 3=outer.3, 4=outer.4, 5=outer.5, 6=outer.6, 7=outer.7, 8=outer.8)
  outs 1=fx64:life/breaker 2=fx64:win/page 3=vl:stmt/imm 4=vl:win/page 5=vl:win/page 6=vl:win/page 7=vl:win/page 8=vl:stmt/imm
