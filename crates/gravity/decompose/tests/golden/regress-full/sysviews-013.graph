-- regress-full-sysviews-013
-- select * from pg_timezone_abbrevs where abbrev = 'LMT';
graph pipelines=3 breakers=2 init_plans=0 root=p2
p0 node=4 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Sort)
  nodes n4@0 n2@3 n1@5^
  source const
  srf from rti=5 [1:Other fn6401 cols=3 fn6401()]
  filter op98(v5.1, c25:'LMT')
  project (1=v5.1, 2=v5.2, 3=v5.3)
  append arm 0/2
  project (1=outer.1, 2=outer.2, 3=outer.3)
  sort keys=1+:Fp128@100 form=runs
  outs 1=vl:row 2=fx16:row 3=w1:val
  outs 1=vl:life/breaker 2=fx16:life/breaker 3=w1:val
p1 node=7 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Sort)
  nodes n7@0 n6@3 n2@5 n1@7^
  source const
  srf from rti=6 [1:Other fn2599 cols=3 fn2599()]
  filter op98(v6.1, c25:'LMT')
  project (1=v6.1, 2=v6.2, 3=v6.3)
  nest inner=n8 JOIN_ANTI invariant vol=s params=()
  inner node=8 serial site=-1 reason=NoDrivingSite end=sink
  nodes n8@0
  source const
  srf from rti=7 [1:Other fn6401 cols=3 fn6401()]
  filter op98(v7.1, c25:'LMT')
  project (1=v7.1, 2=v7.2, 3=v7.3)
  project (1=outer.1, 2=outer.2, 3=outer.3)
  append arm 1/2
  project (1=outer.1, 2=outer.2, 3=outer.3)
  sort keys=1+:Fp128@100 form=runs
  outs 1=vl:row 2=fx16:row 3=w1:val
  outs 1=vl:row 2=fx16:row 3=w1:val
  outs 1=vl:life/breaker 2=fx16:life/breaker 3=w1:val
p2 node=1 serial site=-1 reason=NoDrivingSite end=sink
  desc consumes=slot0@p1
  nodes n1@0
  source breaker slot=0
  project (1=outer.1, 2=outer.2, 3=outer.3)
  outs 1=vl:life/breaker 2=fx16:life/breaker 3=w1:val
breaker slot=0 kind=Sort budget=Share spill=Runs producer=p0 layout=[Fp128,Fp128]->[Count@16] 24B order=1+
breaker slot=0 kind=Sort budget=Share spill=Runs producer=p1 layout=[Fp128,Fp128]->[Count@16] 24B order=1+
