-- regress-full-join-110
-- explain (verbose, costs off) select * from int4_tbl left join ( select text 'foo' union all select text 'bar' ) ss(x) on true where ss.x is null;
graph pipelines=4 breakers=3 init_plans=0 root=p3
p0 node=4 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Materialize)
  nodes n4@0 n3@1^
  source const
  project (1=c25:'foo')
  feed slot=0
  outs 1=vl:stmt/imm
p1 node=5 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Materialize)
  nodes n5@0 n3@1^
  source const
  project (1=c25:'bar')
  feed slot=0
  outs 1=vl:stmt/imm
p2 node=3 serial site=-1 reason=NoDrivingSite end=breaker(slot=1 Materialize)
  desc consumes=slot0@p1
  nodes n3@0 n2@2^
  source breaker slot=0
  append union slot=0 children=2
  project (1=outer.1)
  spool
  outs 1=vl:life/breaker
p3 node=1 eligible rows=5 end=sink
  desc consumes=slot1@p2
  nodes n1@0 n0@1
  source range rel=16400 rti=1 am=heap
    lanes Attr(1):byval8:w8:val Offset:byval2:w2:val
  project (1=v1.1)
  nest inner=n2 JOIN_LEFT invariant raise-free params=()
  inner node=2 serial site=-1 reason=NoDrivingSite end=sink
  desc consumes=slot1@p2
  nodes n2@0
  source breaker slot=1
  project (1=outer.1)
  filter isnull(inner.1)
  project (1=outer.1, 2=inner.1)
  outs 1=w8:val
  outs 1=w8:val 2=vl:life/breaker
breaker slot=0 kind=Materialize budget=Share spill=Runs producer=p0 layout=[]->[Count@0] 8B
breaker slot=0 kind=Materialize budget=Share spill=Runs producer=p1 layout=[]->[Count@0] 8B
breaker slot=1 kind=Materialize budget=Share spill=Runs producer=p2 layout=[]->[Count@0] 8B
