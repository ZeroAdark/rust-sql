-- regress-full-union-030
-- explain (costs off) select x from (values ('11'::varbit), ('10'::varbit)) _(x) union select x from (values ('11'::varbit), ('10'::varbit)) _(x);
graph pipelines=4 breakers=3 init_plans=0 root=p3
p0 node=4 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Sort)
  nodes n4@0 n2@1 n1@3^
  source values rti=4 rows=2
    row (c1562:'\x02\x00\x00\x00\xc0')
    row (c1562:'\x02\x00\x00\x00\x80')
  project (1=v4.1)
  append arm 0/2
  project (1=outer.1)
  sort keys=1+:Fp128/Bits form=runs
  outs 1=vl:row
  outs 1=vl:life/breaker
p1 node=6 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Sort)
  nodes n6@0 n2@1 n1@3^
  source values rti=6 rows=2
    row (c1562:'\x02\x00\x00\x00\xc0')
    row (c1562:'\x02\x00\x00\x00\x80')
  project (1=v6.1)
  append arm 1/2
  project (1=outer.1)
  sort keys=1+:Fp128/Bits form=runs
  outs 1=vl:row
  outs 1=vl:life/breaker
p2 node=1 serial site=-1 reason=NoDrivingSite end=breaker(slot=1 Distinct)
  desc consumes=slot0@p1 owner=key/0 words=bits@3/5
  nodes n1@0 n0@1^
  source breaker slot=0
  project (1=outer.1)
  outs 1=vl:life/breaker
p3 node=0 serial site=-1 reason=NoDrivingSite end=sink
  desc consumes=slot1@p2
  nodes n0@0
  source breaker slot=1
  project (1=outer.1)
  outs 1=vl:life/breaker
breaker slot=0 kind=Sort budget=Share spill=Runs producer=p0 layout=[Fp128,Fp128]->[Count@16] 24B order=1+
breaker slot=0 kind=Sort budget=Share spill=Runs producer=p1 layout=[Fp128,Fp128]->[Count@16] 24B order=1+
breaker slot=1 kind=Distinct budget=Share spill=Partitioned { bits: 3 } producer=p2 layout=[Fp128,Fp128]->[MinCode@16,Count@24] 32B order=1+
group slot=1 producer=p2 node=0 form=Unique hints=[] layout=[Fp128,Fp128]->[MinCode@16,Count@24] 32B
  key 0 word=0 resno=1 kind=Fp128 attno=0 type=1562 rep=0 image=Bits expr=outer.1
