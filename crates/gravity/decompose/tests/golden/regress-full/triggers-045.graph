-- regress-full-triggers-045
-- merge into parted_trig using (select 1) as ss on true when matched and a = 2 then update set a = 1;
graph pipelines=2 breakers=0 init_plans=0 root=p1
p0 node=2 serial site=1 reason=Write end=sink
  nodes n2@0 n1@1 n0@3
  source range rel=21713 rti=5 am=heap
    lanes Attr(1):byval8:w8:val Offset:byval2:w2:val RowId:byval8:w8:val
  project (1=v5.-6, 2=v5.-1, 3j=v5.1)
  append arm 0/2
  project (1j=outer.1, 2j=outer.2, 3j=outer.3)
  write MERGE rel=21713 rti=5 natts=1 indexes=() tableoid=outer.1 route=rti1:21710 natts=1 cross-partition
    target rti=6 rel=21716 natts=1 indexes=()
      when matched and (op96(v6.1, c23:2)) then update set=(1) (1=c23:1)
    merge rowid=outer.2 target_cols=(1@3)
    when matched and (op96(v5.1, c23:2)) then update set=(1) (1=c23:1)
  outs 1=w4:val 2=fx6:row 3=w8:val
  outs 1=w4:val 2=fx6:life/breaker 3=w4:val
p1 node=3 serial site=1 reason=Write end=sink
  nodes n3@0 n1@1 n0@3
  source range rel=21716 rti=6 am=heap
    lanes Attr(1):byval8:w8:val Offset:byval2:w2:val RowId:byval8:w8:val
  project (1=v6.-6, 2=v6.-1, 3j=v6.1)
  append arm 1/2
  project (1j=outer.1, 2j=outer.2, 3j=outer.3)
  write MERGE rel=21713 rti=5 natts=1 indexes=() tableoid=outer.1 route=rti1:21710 natts=1 cross-partition
    target rti=6 rel=21716 natts=1 indexes=()
      when matched and (op96(v6.1, c23:2)) then update set=(1) (1=c23:1)
    merge rowid=outer.2 target_cols=(1@3)
    when matched and (op96(v5.1, c23:2)) then update set=(1) (1=c23:1)
  outs 1=w4:val 2=fx6:row 3=w8:val
  outs 1=w4:val 2=fx6:life/breaker 3=w4:val
scan-lanes node=2 rti=5 rel=21713 tableoid
scan-lanes node=3 rti=6 rel=21716 tableoid
mapped: ModifyTable Append SeqScan
