-- regress-full-window-033
-- select x, lag(x, 1) over (order by x), lead(x, 3) over (order by x) from (select x::numeric as x from generate_series(1,10) x);
graph pipelines=3 breakers=2 init_plans=0 root=p2
p0 node=2 serial site=-1 reason=NoDrivingSite end=breaker(slot=0 Sort)
  nodes n2@0 n1@2^
  source const
  srf from rti=2 [1:SeriesInt { width: 4, step: false } fn1067 fn1067(c23:1, c23:10)]
  project (1=fn1740(v2.1), 2=v2.1)
  sort keys=1+:I64/NumMantissa.0 form=runs
  outs 1=vl:call1740 2=w4:val
p1 node=1 serial site=-1 reason=NoDrivingSite end=breaker(slot=1 Materialize)
  desc consumes=slot0@p0
  nodes n1@0 n0@1^
  source breaker slot=0
  project (1=outer.1, 2=outer.2)
  outs 1=vl:call1740 2=w4:val
p2 node=0 serial site=-1 reason=NoDrivingSite end=sink
  desc consumes=slot1@p1
  nodes n0@0
  source breaker slot=1
  window ref=1 top partition= order=1=1752:Fp128 frame=Range unbounded-preceding..current-row
    fn resno=2 Lag cursor=row,partition, win3107(outer.1, c23:1)
    fn resno=3 Lead cursor=row,partition, win3110(outer.1, c23:3)
  project (1=outer.1, 2=outer.3, 3=outer.4)
  outs 1=vl:life/breaker 2=vl:life/breaker 3=vl:life/breaker
breaker slot=0 kind=Sort budget=Share spill=Runs producer=p0 layout=[I64]->[Count@8] 16B order=1+
breaker slot=1 kind=Materialize budget=Share spill=Runs producer=p1 layout=[]->[Count@0] 8B order=1+
mapped: FunctionScan Sort WindowAgg
