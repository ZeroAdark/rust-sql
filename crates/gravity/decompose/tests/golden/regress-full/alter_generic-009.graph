  outs 1=w4:val 2=fx64:win/page 3=w8:val 4=w4:val 5=w4:val 6=w4:val 7=w4:val 8=w4:val
  outs 1=fx64:life/breaker 2=fx64:win/page
p2 node=0 serial site=-1 reason=NoDrivingSite end=sink
