-- regress-full-groupingsets-054
-- select ten, grouping(ten) from onek group by grouping sets(ten, four) having grouping(ten) > 0 order by 2,1;
graph pipelines=5 breakers=4 init_plans=0 root=p4
p0 node=3 eligible rows=1000 end=breaker(slot=0 HashAgg)
  desc owner=none/0 words=dense_lo@1,dense_hi@2,bits@3,order@4/5
  nodes n3@0 n1@1^
  source range rel=16417 rti=1 am=heap
    lanes Attr(4):byval8:w8:val Attr(5):byval8:w8:val Offset:byval2:w2:val
  project (1=v1.5, 2=v1.4)
  outs 1=w8:val 2=w8:val
p1 node=3 eligible rows=1000 end=breaker(slot=1 HashAgg)
  desc owner=none/0 words=dense_lo@1,dense_hi@2,bits@3,order@4/5
  nodes n3@0 n1@1^
  source range rel=16417 rti=1 am=heap
    lanes Attr(4):byval8:w8:val Attr(5):byval8:w8:val Offset:byval2:w2:val
  project (1=v1.5, 2=v1.4)
  outs 1=w8:val 2=w8:val
p2 node=1 serial site=-1 reason=NoDrivingSite end=breaker(slot=2 Sort)
  desc consumes=slot0@p0
  nodes n1@2 n0@3^
  source breaker slot=0
  filter op521(c23:0, c23:0)
  project (1=outer.1, 2=c23:0, 3j=c23:null)
  append arm 0/2
  sort keys=2+:I32,1+:I32 form=runs
  outs 1=w4:val 2=w4:val 3=w4:val
p3 node=1 serial site=-1 reason=NoDrivingSite end=breaker(slot=2 Sort)
  desc consumes=slot1@p1
  nodes n1@2 n0@3^
  source breaker slot=1
  filter op521(c23:1, c23:0)
  project (1=c23:null, 2=c23:1, 3j=outer.2)
  append arm 1/2
  sort keys=2+:I32,1+:I32 form=runs
  outs 1=w4:val 2=w4:val 3=w4:val
p4 node=0 serial site=-1 reason=NoDrivingSite end=sink
  desc consumes=slot2@p3
  nodes n0@0
  source breaker slot=2
  project (1=outer.1, 2=outer.2, 3j=outer.3)
  outs 1=w4:val 2=w4:val 3=w4:val
