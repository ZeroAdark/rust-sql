  nodes n2@0 n1@2 n0@4
  source range rel=16470 rti=2 am=heap
    lanes Attr(1):byval8:w8:val Offset:byval2:w2:val RowId:byval8:w8:val
  filter op521(v2.1, c23:0)
  project (1=v2.-6, 2=v2.-1)
  append arm 0/2
  project (1j=outer.1, 2j=outer.2)
  write DELETE rel=16470 rti=2 natts=2 indexes=() returning tableoid=outer.1 route=rti1:16470 natts=2
    target rti=3 rel=16475 natts=4 indexes=() returning map=(1,2,0,0)
  project (1=v2.1, 2=v2.2)
  outs 1=w4:val 2=fx6:row
  outs 1=w4:val 2=fx6:life/breaker
  outs 1=w4:val 2=vl:row
