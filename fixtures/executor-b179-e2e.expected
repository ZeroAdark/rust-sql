-- bugs/batch-179-mixed-xhigh: C-vs-pgrust parity for the executor/contrib
-- fixes. Expected file captured from C 18.6 (scripts/regress-diff.sh --capture).
\set VERBOSITY verbose
-- regression: an overflowing (+-) endpoint prints through
-- pg_sprintf's "Infinity" spelling, not libc's "inf".
CREATE EXTENSION seg;
SELECT '3e38(+-)3e38'::seg, '-3e38(+-)3e38'::seg, '3e38 .. 3e38'::seg;
      seg      |      seg       |  seg  
---------------+----------------+-------
 0 .. Infinity | -Infinity .. 0 | 3e+38
(1 row)

SELECT seg_upper('3e38(+-)3e38'::seg), seg_lower('-3e38(+-)3e38'::seg);
 seg_upper | seg_lower 
-----------+-----------
  Infinity | -Infinity
(1 row)

-- regression: a VALUES row that references an initplan Param (no
-- SubPlan) is compiled only when the scan reaches it, so a LIMIT that stops
-- before a row calling a forbidden function never permission-checks it.
CREATE ROLE b179u LOGIN;
CREATE FUNCTION b179_secret() RETURNS int LANGUAGE sql AS 'SELECT 42';
REVOKE EXECUTE ON FUNCTION b179_secret() FROM public;
SET ROLE b179u;
SELECT * FROM (VALUES (1), ((SELECT 2) + b179_secret())) v(x) LIMIT 1;
 x 
---
 1
(1 row)

SELECT * FROM (VALUES (1), ((SELECT 2) + b179_secret())) v(x);
ERROR:  42501: permission denied for function b179_secret
SELECT * FROM (VALUES ((SELECT 2) + 1), (3)) v(x) ORDER BY x;
 x 
---
 3
 3
(2 rows)

RESET ROLE;
DROP FUNCTION b179_secret();
DROP ROLE b179u;
-- regression: work_mem is read after the SRF's
-- arguments ran, so a set_config argument raising it governs the
-- materialization (no spill under temp_file_limit = 0).
SET temp_file_limit = 0;
SET work_mem = '64kB';
SELECT count(*) FROM generate_series(1, 200000 + length(set_config('work_mem', '256MB', true)) - 5) g;
 count  
--------
 200000
(1 row)

SHOW work_mem;
 work_mem 
----------
 64kB
(1 row)

RESET temp_file_limit;
RESET work_mem;
-- regression: the bitmap heap scan checks for
-- interrupts before every tuple, so a cancel raised while the first tuple
-- is consumed wins over the second tuple's division by zero.
CREATE TABLE b179t(a int, b int);
CREATE INDEX ON b179t(a);
INSERT INTO b179t VALUES (1, 1), (1, 0);
SET enable_seqscan = off;
SET enable_indexscan = off;
SET enable_indexonlyscan = off;
EXPLAIN (COSTS OFF) SELECT sum(CASE WHEN pg_cancel_backend(pg_backend_pid()) THEN 1/b ELSE 0 END) FROM b179t WHERE a = 1;
                  QUERY PLAN                  
----------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on b179t
         Recheck Cond: (a = 1)
         ->  Bitmap Index Scan on b179t_a_idx
               Index Cond: (a = 1)
(5 rows)

SELECT sum(CASE WHEN pg_cancel_backend(pg_backend_pid()) THEN 1/b ELSE 0 END) FROM b179t WHERE a = 1;
ERROR:  57014: canceling statement due to user request
RESET enable_seqscan;
RESET enable_indexscan;
RESET enable_indexonlyscan;
DROP TABLE b179t;
