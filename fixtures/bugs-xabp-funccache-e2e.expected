-- Differential fixture for XABP (2026-09-16 owner ruling): the plpgsql
-- function cache is keyed and invalidated exactly as C's funccache.c —
-- (function OID, trigger context + trigger OID, input collation, resolved
-- polymorphic/RECORD input argtypes), invalidated only when the pg_proc
-- tuple's xmin/tid change. There is no search_path fingerprint: names in the
-- body are resolved once, at compile time, and survive SET search_path.
-- Rows regression and regression (batch-27).
-- Run via scripts/bugs-xabp-funccache-e2e.sh against the frozen expected
-- captured from C PostgreSQL 18.6.
\set VERBOSITY verbose
\pset pager off
-- regression: an unqualified type name in a DECLARE is resolved
-- when the function is compiled and retained across SET search_path
CREATE SCHEMA p041a; CREATE SCHEMA p041b;
CREATE TYPE p041a.t AS ENUM ('x'); CREATE TYPE p041b.t AS ENUM ('x');
SET search_path = p041a, public;
CREATE FUNCTION public.xabp_cache_type() RETURNS oid LANGUAGE plpgsql AS $$ DECLARE v t; BEGIN RETURN pg_typeof(v)::oid; END $$;
SELECT public.xabp_cache_type() = 'p041a.t'::regtype::oid AS resolved_a;
 resolved_a 
------------
 t
(1 row)

SET search_path = p041b, public;
SELECT public.xabp_cache_type() = 'p041a.t'::regtype::oid AS still_a_after_set_path;
 still_a_after_set_path 
------------------------
 t
(1 row)

-- CREATE OR REPLACE writes a new pg_proc tuple (xmin/tid change): recompiled under the current path
CREATE OR REPLACE FUNCTION public.xabp_cache_type() RETURNS oid LANGUAGE plpgsql AS $$ DECLARE v t; BEGIN RETURN pg_typeof(v)::oid; END $$;
SELECT public.xabp_cache_type() = 'p041b.t'::regtype::oid AS b_after_replace;
 b_after_replace 
-----------------
 t
(1 row)

-- ALTER FUNCTION also rewrites the pg_proc tuple: recompiled
SET search_path = p041a, public;
SELECT public.xabp_cache_type() = 'p041b.t'::regtype::oid AS still_b_after_set_path;
 still_b_after_set_path 
------------------------
 t
(1 row)

ALTER FUNCTION public.xabp_cache_type() COST 50;
SELECT public.xabp_cache_type() = 'p041a.t'::regtype::oid AS a_after_alter_function;
 a_after_alter_function 
------------------------
 t
(1 row)

-- COMMENT ON FUNCTION touches pg_description only: no recompile
SET search_path = p041b, public;
COMMENT ON FUNCTION public.xabp_cache_type() IS 'xabp';
SELECT public.xabp_cache_type() = 'p041a.t'::regtype::oid AS still_a_after_comment;
 still_a_after_comment 
-----------------------
 t
(1 row)

-- dropping the resolved type does not touch pg_proc: the stale OID is retained
DROP TYPE p041a.t;
SELECT public.xabp_cache_type() = 'p041b.t'::regtype::oid AS b_after_drop_type;
 b_after_drop_type 
-------------------
 f
(1 row)

SELECT public.xabp_cache_type() IN (SELECT oid FROM pg_type) AS stale_oid_still_a_type;
 stale_oid_still_a_type 
------------------------
 f
(1 row)

CREATE OR REPLACE FUNCTION public.xabp_cache_type() RETURNS oid LANGUAGE plpgsql AS $$ DECLARE v t; BEGIN RETURN pg_typeof(v)::oid; END $$;
SELECT public.xabp_cache_type() = 'p041b.t'::regtype::oid AS b_after_replace2;
 b_after_replace2 
------------------
 t
(1 row)

RESET search_path;
-- regression: %TYPE against an unqualified relation is resolved at compile time
CREATE SCHEMA p041ca; CREATE SCHEMA p041cb;
CREATE TABLE p041ca.t(x integer); CREATE TABLE p041cb.t(x text);
SET search_path = p041ca, public;
CREATE FUNCTION public.xabp_cached_type() RETURNS text LANGUAGE plpgsql AS $$ DECLARE v t.x%TYPE; BEGIN RETURN pg_typeof(v)::text; END $$;
SELECT public.xabp_cached_type();
 xabp_cached_type 
------------------
 integer
(1 row)

SET search_path = p041cb, public;
SELECT public.xabp_cached_type();
 xabp_cached_type 
------------------
 integer
(1 row)

-- ALTER COLUMN TYPE of the referenced table: pg_proc unchanged, no recompile
ALTER TABLE p041ca.t ALTER COLUMN x TYPE bigint;
SELECT public.xabp_cached_type();
 xabp_cached_type 
------------------
 integer
(1 row)

-- CREATE OR REPLACE under the other schema: re-resolved
CREATE OR REPLACE FUNCTION public.xabp_cached_type() RETURNS text LANGUAGE plpgsql AS $$ DECLARE v t.x%TYPE; BEGIN RETURN pg_typeof(v)::text; END $$;
SELECT public.xabp_cached_type();
 xabp_cached_type 
------------------
 text
(1 row)

SET search_path = p041ca, public;
SELECT public.xabp_cached_type();
 xabp_cached_type 
------------------
 text
(1 row)

-- a fresh session has an empty cache: compiled against the current path
\c
SET search_path = p041ca, public;
SELECT public.xabp_cached_type();
 xabp_cached_type 
------------------
 bigint
(1 row)

\pset pager off
RESET search_path;
-- per-key variants C does keep apart: resolved polymorphic argument types ...
CREATE FUNCTION public.xabp_poly(a anyelement) RETURNS text LANGUAGE plpgsql AS $$ DECLARE v a%TYPE; BEGIN RETURN pg_typeof(v)::text; END $$;
SELECT public.xabp_poly(1), public.xabp_poly('x'::text), public.xabp_poly(1);
 xabp_poly | xabp_poly | xabp_poly 
-----------+-----------+-----------
 integer   | text      | integer
(1 row)

-- ... the input collation ...
CREATE FUNCTION public.xabp_coll(a text) RETURNS text LANGUAGE plpgsql AS $$ BEGIN RETURN pg_collation_for(a); END $$;
SELECT public.xabp_coll('x'), public.xabp_coll('x' COLLATE "C"), public.xabp_coll('x');
 xabp_coll | xabp_coll | xabp_coll 
-----------+-----------+-----------
 "default" | "C"       | "default"
(1 row)

-- ... and the trigger OID (one function, two relations with different rowtypes)
CREATE TABLE xabp_t1(x integer); CREATE TABLE xabp_t2(x text);
CREATE FUNCTION public.xabp_trg() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE NOTICE 'NEW.x is %', pg_typeof(NEW.x); RETURN NEW; END $$;
CREATE TRIGGER xabp_trg1 BEFORE INSERT ON xabp_t1 FOR EACH ROW EXECUTE FUNCTION public.xabp_trg();
CREATE TRIGGER xabp_trg2 BEFORE INSERT ON xabp_t2 FOR EACH ROW EXECUTE FUNCTION public.xabp_trg();
INSERT INTO xabp_t1 VALUES (1); INSERT INTO xabp_t2 VALUES ('a'); INSERT INTO xabp_t1 VALUES (2);
NOTICE:  00000: NEW.x is integer
NOTICE:  00000: NEW.x is text
NOTICE:  00000: NEW.x is integer
