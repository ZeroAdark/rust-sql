-- bugs/batch-73-backend-access-gin: C-vs-pgrust parity for the fixes in
-- access/gin. Expected file captured from C 18.6
-- (scripts/regress-diff.sh --capture).
\set VERBOSITY verbose
CREATE EXTENSION pageinspect;
-- ginbulk.c charges GetMemoryChunkSpace (pow2 freelist bucket + 8-byte
-- header, aset.c:1512) per accumulator allocation: a fresh 5-TID list costs
-- 40 bytes, so under a 1MB maintenance_work_mem the build dumps the
-- accumulator at the same entry as C and the entry tree lays out the same.
CREATE TABLE b73_acc(a int[]);
INSERT INTO b73_acc SELECT ARRAY[g, g + 100000, g + 200000] FROM generate_series(1, 40000) g;
SET maintenance_work_mem = '1MB';
CREATE INDEX b73_acc_idx ON b73_acc USING gin(a) WITH (fastupdate=off);
SELECT pg_relation_size('b73_acc_idx') / 8192 AS pages;
 pages 
-------
   819
(1 row)

SELECT n_entry_pages, n_data_pages, n_entries FROM gin_metapage_info(get_raw_page('b73_acc_idx', 0));
 n_entry_pages | n_data_pages | n_entries 
---------------+--------------+-----------
           818 |            0 |    120000
(1 row)

DROP INDEX b73_acc_idx;
RESET maintenance_work_mem;
CREATE INDEX b73_acc_idx ON b73_acc USING gin(a) WITH (fastupdate=off);
SELECT pg_relation_size('b73_acc_idx') / 8192 AS pages;
 pages 
-------
   821
(1 row)

SELECT n_entry_pages, n_data_pages, n_entries FROM gin_metapage_info(get_raw_page('b73_acc_idx', 0));
 n_entry_pages | n_data_pages | n_entries 
---------------+--------------+-----------
           820 |            0 |    120000
(1 row)

DROP TABLE b73_acc;
