\set VERBOSITY verbose
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_am WHERE amname = 'pgrcolumnar2') THEN CREATE ACCESS METHOD pgrcolumnar2 TYPE TABLE HANDLER heap_tableam_handler; END IF; END $$;
-- b values 4294967297 (2^32 + 1) and -4294967295 (-2^32 + 1) have the same low 32 bits as 1
CREATE TABLE q1 (id int NOT NULL, g int NOT NULL, b int8 NOT NULL) USING pgrcolumnar2;
COPY q1 FROM stdin;
ANALYZE q1;
-- controls: the ungrouped filter, and the rows themselves
SELECT count(*) FROM q1 WHERE b = 1 AND id > 0;
 count 
-------
     2
(1 row)

SELECT id, g, b FROM q1 WHERE b = 1 AND id > 0 ORDER BY id;
 id | g | b 
----+---+---
  1 | 1 | 1
  3 | 2 | 1
(2 rows)

-- decisive: the same filter under GROUP BY g
SELECT g, count(*) FROM q1 WHERE b = 1 AND id > 0 GROUP BY g ORDER BY g;
 g | count 
---+-------
 1 |     1
 2 |     1
(2 rows)

SELECT g, count(*) FROM q1 WHERE b = 4294967297 AND id > 0 GROUP BY g ORDER BY g;
 g | count 
---+-------
 1 |     1
(1 row)

SELECT g, count(*) FROM q1 WHERE b = 1::int8 AND id > 0 GROUP BY g ORDER BY g;
 g | count 
---+-------
 1 |     1
 2 |     1
(2 rows)

SELECT g, count(*) FROM q1 WHERE b IN (1) AND id < 100 GROUP BY g ORDER BY g;
 g | count 
---+-------
 1 |     1
 2 |     1
(2 rows)

-- decisive: range conditions on b next to an equality on another column are cut to 32 bits too
SELECT g, count(*) FROM q1 WHERE id = 2 AND b > 1 GROUP BY g ORDER BY g;
 g | count 
---+-------
 1 |     1
(1 row)

SELECT id, count(*) FROM q1 WHERE g = 1 AND b >= 2 GROUP BY id ORDER BY id;
 id | count 
----+-------
  2 |     1
(1 row)

