-- bugs/batch-253-backend-executor-execmain: fixes verified against C 18.6.
\set VERBOSITY verbose
-- regression: ExecShutdownNode's walker shuts a node's
-- initplans down inside that node's instrumentation window
-- (execProcnode.c:795-827), so a Gather inside an initplan folds its workers'
-- buffer usage into the owning Result's counters and EXPLAIN (ANALYZE,
-- BUFFERS) prints a Buffers line on the Result.
CREATE TABLE b253_pt(x int);
INSERT INTO b253_pt SELECT g FROM generate_series(1, 20000) g;
ANALYZE b253_pt;
CREATE FUNCTION b253_initplan_buffers() RETURNS text LANGUAGE plpgsql AS $$
DECLARE
  line text;
  txt text := '';
BEGIN
  FOR line IN EXECUTE 'EXPLAIN (ANALYZE, BUFFERS, COSTS OFF, TIMING OFF, SUMMARY OFF) '
      'SELECT (SELECT x FROM b253_pt LIMIT 1)'
  LOOP
    txt := txt || line || E'\n';
  END LOOP;
  IF txt !~ 'Workers Launched: [1-9]' THEN
    RETURN 'no worker launched';
  END IF;
  IF txt !~ E'^Result \\(actual[^\n]*\n\\s+Buffers: shared hit=[1-9]' THEN
    RETURN 'result lacks initplan buffers';
  END IF;
  RETURN 'result carries initplan buffers';
END
$$;
SET max_parallel_workers_per_gather = 2;
SET min_parallel_table_scan_size = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET parallel_leader_participation = off;
SELECT b253_initplan_buffers();
      b253_initplan_buffers      
---------------------------------
 result carries initplan buffers
(1 row)

RESET max_parallel_workers_per_gather;
RESET min_parallel_table_scan_size;
RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET parallel_leader_participation;
DROP FUNCTION b253_initplan_buffers();
DROP TABLE b253_pt;
