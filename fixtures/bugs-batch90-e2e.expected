-- Differential fixture for the 2026-09-13 audit bug batch 90
-- (backend/utils/sort: tuplestore_end surfaces the final BufFile flush
-- error the way C's BufFileClose ereports it; sts_puttuple does not flush
-- the freshly allocated first chunk ahead of an oversized tuple). Run via
-- scripts/bugs-batch90-e2e.sh against the frozen expected captured from C
-- PostgreSQL 18.6.
\pset pager off
-- regression: a materialized CTE read up to a LIMIT stays in write
-- mode with a dirty BufFile buffer; the flush at tuplestore_end crosses
-- temp_file_limit, so C reports the file error at end of query (LIMIT 96
-- stays under the limit).
SET work_mem = '64kB';
SET temp_file_limit = '96kB';
WITH s AS MATERIALIZED (SELECT repeat('x', 1000) AS x FROM generate_series(1, 1000))
SELECT count(*) FROM (SELECT * FROM s LIMIT 97) q;
ERROR:  temporary file size exceeds "temp_file_limit" (96kB)
WITH s AS MATERIALIZED (SELECT repeat('x', 1000) AS x FROM generate_series(1, 1000))
SELECT count(*) FROM (SELECT * FROM s LIMIT 96) q;
 count 
-------
    96
(1 row)

RESET temp_file_limit;
RESET work_mem;
-- regression: Parallel Hash Join run by the leader alone
-- (workers planned, none launched) whose batch files receive 40000-byte
-- computed tuples; an extra empty 32kB chunk per participant file pushed the
-- run over a temp_file_limit C stays under.
SET max_parallel_workers_per_gather = 2;
SET max_parallel_workers = 0;
SET enable_mergejoin = off;
SET enable_nestloop = off;
SET work_mem = '64kB';
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET temp_file_limit = '1216kB';
CREATE TABLE bugs_b90_big AS SELECT g AS id FROM generate_series(1, 24) g;
ANALYZE bugs_b90_big;
EXPLAIN (COSTS OFF)
SELECT sum(length(x) + length(y))
FROM (SELECT id, repeat('x', 40000 + (extract(epoch FROM clock_timestamp()) * 0)::int) AS x FROM bugs_b90_big) a
JOIN (SELECT id, repeat('y', 40000 + (extract(epoch FROM clock_timestamp()) * 0)::int) AS y FROM bugs_b90_big) b USING (id);
                                      QUERY PLAN                                      
--------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 1
         ->  Partial Aggregate
               ->  Parallel Hash Join
                     Hash Cond: (bugs_b90_big.id = b.id)
                     ->  Parallel Seq Scan on bugs_b90_big
                     ->  Parallel Hash
                           ->  Subquery Scan on b
                                 ->  Parallel Seq Scan on bugs_b90_big bugs_b90_big_1
(10 rows)

SELECT sum(length(x) + length(y))
FROM (SELECT id, repeat('x', 40000 + (extract(epoch FROM clock_timestamp()) * 0)::int) AS x FROM bugs_b90_big) a
JOIN (SELECT id, repeat('y', 40000 + (extract(epoch FROM clock_timestamp()) * 0)::int) AS y FROM bugs_b90_big) b USING (id);
   sum   
---------
 1920000
(1 row)

DROP TABLE bugs_b90_big;
RESET ALL;
