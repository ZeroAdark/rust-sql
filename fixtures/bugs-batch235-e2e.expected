-- bugs/batch-235-mixed-lowtail: SQL-level regressions, expected captured from C 18.6.
\set VERBOSITY verbose
-- regression: ImportSnapshot formats the pathname with snprintf(path, MAXPGPATH, ...),
-- so an over-long identifier reports a pathname cut at 1023 bytes.
BEGIN ISOLATION LEVEL REPEATABLE READ;
SET TRANSACTION SNAPSHOT '';
ERROR:  58P03: could not open file "pg_" for reading: File name too long
ROLLBACK;
-- regression: ts_headline runs hlparsetext before deserialize_deflist, so a
-- dictionary failure surfaces ahead of a malformed options list.
CREATE TEXT SEARCH DICTIONARY b235_sub (TEMPLATE = simple);
CREATE TEXT SEARCH DICTIONARY b235_thes (TEMPLATE = thesaurus, DictFile = thesaurus_sample, Dictionary = b235_sub);
CREATE TEXT SEARCH CONFIGURATION b235_cfg (COPY = english);
ALTER TEXT SEARCH CONFIGURATION b235_cfg ALTER MAPPING FOR asciiword WITH b235_thes, english_stem;
SELECT ts_headline('b235_cfg', 'one two three', 'one'::tsquery, 'bogus');
ERROR:  42601: invalid parameter list format: "bogus"
SELECT ts_headline('b235_cfg', 'one two three', 'one'::tsquery, 'MaxWords=2');
ERROR:  22023: MinWords must be less than MaxWords
DROP TEXT SEARCH DICTIONARY b235_sub;
SELECT ts_headline('b235_cfg', 'one two three', 'one'::tsquery, 'bogus');
ERROR:  42704: text search dictionary "b235_sub" does not exist
SELECT ts_headline('b235_cfg', 'one two three', 'one'::tsquery);
ERROR:  42704: text search dictionary "b235_sub" does not exist
DROP TEXT SEARCH CONFIGURATION b235_cfg;
DROP TEXT SEARCH DICTIONARY b235_thes;
