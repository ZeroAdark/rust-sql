-- Differential fixture for the 2026-09-13 audit bug batch 121
-- (backend/utils/fmgr). Run via scripts/bugs-batch121-e2e.sh against the
-- frozen expected captured from C PostgreSQL 18.6.
\pset pager off
\set VERBOSITY verbose
-- regression: ssl_extension_info called with a
-- non-composite declared result is 0A000 "function returning record called
-- in context that cannot accept type record" (sslinfo.c:380), for SETOF
-- scalar and scalar declarations alike; a composite declaration still works
-- without a client certificate.
CREATE FUNCTION b121_ssl_ext_setof_text() RETURNS SETOF text AS '$libdir/sslinfo', 'ssl_extension_info' LANGUAGE C;
SELECT * FROM b121_ssl_ext_setof_text();
ERROR:  0A000: function returning record called in context that cannot accept type record
CREATE FUNCTION b121_ssl_ext_text() RETURNS text AS '$libdir/sslinfo', 'ssl_extension_info' LANGUAGE C;
SELECT * FROM b121_ssl_ext_text();
ERROR:  0A000: function returning record called in context that cannot accept type record
SELECT b121_ssl_ext_text();
ERROR:  0A000: set-valued function called in context that cannot accept a set
CREATE FUNCTION b121_ssl_ext_record() RETURNS SETOF record AS '$libdir/sslinfo', 'ssl_extension_info' LANGUAGE C;
SELECT * FROM b121_ssl_ext_record() AS t(name text, value text, critical boolean);
 name | value | critical 
------+-------+----------
(0 rows)

DROP FUNCTION b121_ssl_ext_setof_text();
DROP FUNCTION b121_ssl_ext_text();
DROP FUNCTION b121_ssl_ext_record();
