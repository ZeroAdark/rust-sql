-- bugs/batch-126-backend-commands-dbcommands: the database object-access
-- hook sites of dbcommands.c (createdb:1510 post-create, dropdb:1725 drop,
-- RenameDatabase:1986 / movedb:2244 / AlterDatabase:2526 post-alter),
-- witnessed through the test_oat_hooks recorder. The C oracle install carries
-- no test modules, so the expected file is captured from pgrust.
LOAD 'test_oat_hooks';
SET allow_in_place_tablespaces = on;
CREATE TABLESPACE b126_oat_ts LOCATION '';
SET test_oat_hooks.audit = on;
NOTICE:  in object_access_hook_str: superuser attempting alter (subId=0x1000, set) [test_oat_hooks.audit]
NOTICE:  in object_access_hook_str: superuser finished alter (subId=0x1000, set) [test_oat_hooks.audit]
CREATE DATABASE b126_oat;
NOTICE:  in object access: superuser attempting create (subId=0x0) [explicit]
NOTICE:  in object access: superuser finished create (subId=0x0) [explicit]
ALTER DATABASE b126_oat CONNECTION LIMIT 2;
NOTICE:  in object access: superuser attempting alter (subId=0x0) [explicit without auxiliary object]
NOTICE:  in object access: superuser finished alter (subId=0x0) [explicit without auxiliary object]
ALTER DATABASE b126_oat RENAME TO b126_oat2;
NOTICE:  in object access: superuser attempting alter (subId=0x0) [explicit without auxiliary object]
NOTICE:  in object access: superuser finished alter (subId=0x0) [explicit without auxiliary object]
ALTER DATABASE b126_oat2 SET TABLESPACE b126_oat_ts;
NOTICE:  in object access: superuser attempting alter (subId=0x0) [explicit without auxiliary object]
NOTICE:  in object access: superuser finished alter (subId=0x0) [explicit without auxiliary object]
DROP DATABASE b126_oat2;
NOTICE:  in object access: superuser attempting drop (subId=0x0) []
NOTICE:  in object access: superuser finished drop (subId=0x0) []
SET test_oat_hooks.audit = off;
DROP TABLESPACE b126_oat_ts;
