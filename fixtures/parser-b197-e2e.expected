-- bugs/batch-197-backend-parser: parser fixes, expected captured from C 18.6.
\set VERBOSITY verbose
-- regression: unqualified type lookup walks the active path
-- (namespace.c:1008 TypenameGetTypidExtended) without forcing pg_temp into
-- existence. Runs first: the session's temp namespace must not exist yet.
CREATE ROLE b197_notemp LOGIN;
SELECT format('REVOKE TEMP ON DATABASE %I FROM PUBLIC', current_database()) \gexec
REVOKE TEMP ON DATABASE postgres FROM PUBLIC
SET ROLE b197_notemp;
SET search_path = pg_temp, public;
SELECT 1::int4;
 int4 
------
    1
(1 row)

SELECT 1::nosuchtype;
ERROR:  42704: type "nosuchtype" does not exist
LINE 1: SELECT 1::nosuchtype;
                  ^
CREATE TEMP TABLE b197_tmp (a int);
ERROR:  42501: permission denied to create temporary tables in database "postgres"
LINE 1: CREATE TEMP TABLE b197_tmp (a int);
                          ^
RESET search_path;
RESET ROLE;
SELECT format('GRANT TEMP ON DATABASE %I TO PUBLIC', current_database()) \gexec
GRANT TEMP ON DATABASE postgres TO PUBLIC
DROP ROLE b197_notemp;
-- regression: ExpandRowReference copies the expression per field
-- (parse_target.c:1484), so the grouped-column substitution of an ordered-set
-- aggregate's direct arguments runs once per copy.
CREATE TYPE b197_ct AS (a int, b int);
CREATE TABLE b197_t0 (g int, c b197_ct);
INSERT INTO b197_t0 VALUES (1, (1,2)), (1, (3,4)), (2, (5,6));
SELECT g, (percentile_disc(g/10.0) WITHIN GROUP (ORDER BY c)).* FROM b197_t0 GROUP BY g ORDER BY g;
 g | a | b 
---+---+---
 1 | 1 | 2
 2 | 5 | 6
(2 rows)

SELECT (percentile_disc(g/10.0) WITHIN GROUP (ORDER BY c)).* FROM b197_t0 GROUP BY g ORDER BY 1;
 a | b 
---+---
 1 | 2
 5 | 6
(2 rows)

SELECT ((percentile_disc((c).a/10.0) WITHIN GROUP (ORDER BY c)).*) FROM b197_t0 GROUP BY g;
ERROR:  42803: column "b197_t0.c" must appear in the GROUP BY clause or be used in an aggregate function
LINE 1: SELECT ((percentile_disc((c).a/10.0) WITHIN GROUP (ORDER BY ...
                                  ^
DETAIL:  Direct arguments of an ordered-set aggregate must use only grouped columns.
DROP TABLE b197_t0;
DROP TYPE b197_ct;
-- regression: LIKE INCLUDING INDEXES clones of WITHOUT OVERLAPS
-- constraints carry excludeOpNames (parse_utilcmd.c:1818), so ChooseIndexName
-- picks the "excl" suffix.
CREATE TABLE b197_p5 (r1 int4range, valid_at daterange, UNIQUE (r1, valid_at WITHOUT OVERLAPS));
CREATE TABLE b197_p5b (r1 int4range, valid_at daterange, PRIMARY KEY (r1, valid_at WITHOUT OVERLAPS));
CREATE TABLE b197_c5 (LIKE b197_p5 INCLUDING INDEXES);
CREATE TABLE b197_c5b (LIKE b197_p5b INCLUDING INDEXES);
SELECT conrelid::regclass, conname, contype, conperiod, conexclop FROM pg_constraint
  WHERE conrelid IN ('b197_p5'::regclass, 'b197_c5'::regclass, 'b197_p5b'::regclass, 'b197_c5b'::regclass)
  ORDER BY conrelid::regclass::text, conname;
 conrelid |          conname           | contype | conperiod |  conexclop  
----------+----------------------------+---------+-----------+-------------
 b197_c5  | b197_c5_r1_valid_at_excl   | u       | t         | {3882,3888}
 b197_c5b | b197_c5b_pkey              | p       | t         | {3882,3888}
 b197_c5b | b197_p5b_r1_not_null       | n       | f         | 
 b197_c5b | b197_p5b_valid_at_not_null | n       | f         | 
 b197_p5  | b197_p5_r1_valid_at_key    | u       | t         | {3882,3888}
 b197_p5b | b197_p5b_pkey              | p       | t         | {3882,3888}
 b197_p5b | b197_p5b_r1_not_null       | n       | f         | 
 b197_p5b | b197_p5b_valid_at_not_null | n       | f         | 
(8 rows)

SELECT indrelid::regclass, indexrelid::regclass FROM pg_index
  WHERE indrelid IN ('b197_p5'::regclass, 'b197_c5'::regclass, 'b197_p5b'::regclass, 'b197_c5b'::regclass)
  ORDER BY 1::text, 2::text;
 indrelid |        indexrelid        
----------+--------------------------
 b197_p5  | b197_p5_r1_valid_at_key
 b197_p5b | b197_p5b_pkey
 b197_c5  | b197_c5_r1_valid_at_excl
 b197_c5b | b197_c5b_pkey
(4 rows)

INSERT INTO b197_c5 VALUES ('[1,2)', '[2020-01-01,2020-02-01)');
INSERT INTO b197_c5 VALUES ('[1,2)', '[2020-01-15,2020-03-01)');
ERROR:  23P01: conflicting key value violates exclusion constraint "b197_c5_r1_valid_at_excl"
DETAIL:  Key (r1, valid_at)=([1,2), [01-15-2020,03-01-2020)) conflicts with existing key (r1, valid_at)=([1,2), [01-01-2020,02-01-2020)).
SCHEMA NAME:  public
TABLE NAME:  b197_c5
CONSTRAINT NAME:  b197_c5_r1_valid_at_excl
DROP TABLE b197_p5, b197_p5b, b197_c5, b197_c5b;
-- regression / regression: query_tree_mutator visits
-- jointree before havingQual (nodeFuncs.c:3794-3796).
CREATE TABLE b197_t6 (g int, b int, c int);
CREATE TABLE b197_t6b (a int);
SELECT (SELECT count(*) FROM b197_t6b WHERE b197_t6b.a = b197_t6.b HAVING max(b197_t6b.a) > b197_t6.c) FROM b197_t6 GROUP BY b197_t6.g;
ERROR:  42803: subquery uses ungrouped column "b197_t6.b" from outer query
LINE 1: ...(SELECT count(*) FROM b197_t6b WHERE b197_t6b.a = b197_t6.b ...
                                                             ^
SELECT (SELECT count(*) FROM b197_t6b HAVING max(b197_t6b.a) > b197_t6.c) FROM b197_t6 GROUP BY b197_t6.g;
ERROR:  42803: subquery uses ungrouped column "b197_t6.c" from outer query
LINE 1: ...T count(*) FROM b197_t6b HAVING max(b197_t6b.a) > b197_t6.c)...
                                                             ^
SELECT (SELECT count(*) FROM b197_t6b WHERE b197_t6b.a = b197_t6.g HAVING max(b197_t6b.a) > b197_t6.g) FROM b197_t6 GROUP BY b197_t6.g;
 count 
-------
(0 rows)

DROP TABLE b197_t6, b197_t6b;
-- regression: the set-returning-function rejection is positioned
-- with exprLocation(node) (parse_agg.c:815), the leftmost operand of an OpExpr.
CREATE FUNCTION b197_srf(int, int) RETURNS SETOF int LANGUAGE sql AS 'SELECT $1 UNION ALL SELECT $2';
CREATE OPERATOR ## (LEFTARG = int, RIGHTARG = int, FUNCTION = b197_srf);
SELECT count(1 ## 2);
ERROR:  0A000: aggregate function calls cannot contain set-returning function calls
LINE 1: SELECT count(1 ## 2);
                     ^
HINT:  You might be able to move the set-returning function into a LATERAL FROM item.
SELECT count(b197_srf(1, 2));
ERROR:  0A000: aggregate function calls cannot contain set-returning function calls
LINE 1: SELECT count(b197_srf(1, 2));
                     ^
HINT:  You might be able to move the set-returning function into a LATERAL FROM item.
SELECT count(1 + (3 ## 2));
ERROR:  0A000: aggregate function calls cannot contain set-returning function calls
LINE 1: SELECT count(1 + (3 ## 2));
                          ^
HINT:  You might be able to move the set-returning function into a LATERAL FROM item.
DROP OPERATOR ## (int, int);
DROP FUNCTION b197_srf(int, int);
-- regression: transformAExprIn copies the left operand per
-- comparison (parse_expr.c:1275), so an unknown Param is deduced per column.
CREATE TABLE b197_t13 (a int, b bigint);
PREPARE b197_p13 AS SELECT 1 FROM b197_t13 WHERE $1 IN (a, b);
ERROR:  42P08: inconsistent types deduced for parameter $1
LINE 1: PREPARE b197_p13 AS SELECT 1 FROM b197_t13 WHERE $1 IN (a, b...
                                                         ^
DETAIL:  integer versus bigint
PREPARE b197_p13b AS SELECT 1 FROM b197_t13 WHERE $1 IN (a, a);
SELECT parameter_types FROM pg_prepared_statements WHERE name = 'b197_p13b';
 parameter_types 
-----------------
 {integer}
(1 row)

DEALLOCATE b197_p13b;
DROP TABLE b197_t13;
-- regression: transformAExprNullIf hands make_op the current
-- p_last_srf (parse_expr.c:1092), so the SRF placement check passes and the
-- set-returning = operator is rejected as NULLIF's.
CREATE FUNCTION b197_pteq(point, point) RETURNS SETOF bool LANGUAGE sql AS 'SELECT true UNION ALL SELECT false';
CREATE OPERATOR = (LEFTARG = point, RIGHTARG = point, FUNCTION = b197_pteq);
CREATE FUNCTION b197_ptsrf() RETURNS SETOF point LANGUAGE sql AS 'SELECT point(1,1)';
SELECT nullif(point(1,1), point(2,2));
ERROR:  42804: NULLIF must not return a set
LINE 1: SELECT nullif(point(1,1), point(2,2));
               ^
SELECT * FROM generate_series(1, (nullif(b197_ptsrf(), point(0,0)))[0]::int);
ERROR:  42804: NULLIF must not return a set
LINE 1: SELECT * FROM generate_series(1, (nullif(b197_ptsrf(), point...
                                          ^
SELECT nullif(b197_ptsrf(), point(0,0));
ERROR:  42804: NULLIF must not return a set
LINE 1: SELECT nullif(b197_ptsrf(), point(0,0));
               ^
DROP OPERATOR = (point, point);
DROP FUNCTION b197_pteq(point, point);
DROP FUNCTION b197_ptsrf();
