-- regression: r.* skips an inner scalar r (pl_funcs.c:146) and
-- finds the outer record.
DO $$ DECLARE r record; x int; BEGIN SELECT 1 AS a, 2 AS b INTO r;
  DECLARE r int := 5; BEGIN
    RAISE NOTICE 'r=%', r;
    RAISE NOTICE 'ra=%', r.a;
    SELECT count(*) INTO x FROM (SELECT r.*) s; RAISE NOTICE 'x=%', x;
  END;
END $$;
NOTICE:  00000: r=5
NOTICE:  00000: ra=1
