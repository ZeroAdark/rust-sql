-- bugs/batch-108-backend-access-index: expected captured from C 18.6
-- (scripts/access-index-b108-e2e.sh).
\set VERBOSITY verbose
-- regression / regression: an access method whose handler is
-- bthandler translates compare types/strategies like btree (nbtree.c:1763,
-- 1783 ignore the AM oid), so foreign keys and ON CONFLICT work on it.
CREATE ACCESS METHOD b108_bt_alias TYPE INDEX HANDLER bthandler;
CREATE OPERATOR CLASS b108_alias_int_ops DEFAULT FOR TYPE int4 USING b108_bt_alias AS OPERATOR 1 < (int4,int4), OPERATOR 2 <= (int4,int4), OPERATOR 3 = (int4,int4), OPERATOR 4 >= (int4,int4), OPERATOR 5 > (int4,int4), FUNCTION 1 btint4cmp(int4,int4);
CREATE TABLE b108_parent (id int4);
CREATE UNIQUE INDEX b108_parent_u ON b108_parent USING b108_bt_alias (id);
CREATE TABLE b108_child (id int4 REFERENCES b108_parent(id));
INSERT INTO b108_parent VALUES (1);
INSERT INTO b108_parent VALUES (1) ON CONFLICT DO NOTHING;
INSERT INTO b108_parent VALUES (1) ON CONFLICT (id) DO UPDATE SET id = excluded.id + 1 RETURNING id;
 id 
----
  2
(1 row)

INSERT INTO b108_child VALUES (2);
INSERT INTO b108_child VALUES (5);
ERROR:  23503: insert or update on table "b108_child" violates foreign key constraint "b108_child_id_fkey"
DETAIL:  Key (id)=(5) is not present in table "b108_parent".
SCHEMA NAME:  public
TABLE NAME:  b108_child
CONSTRAINT NAME:  b108_child_id_fkey
SELECT * FROM b108_parent ORDER BY id;
 id 
----
  2
(1 row)

-- regression: a LANGUAGE internal alias of bthandler is the btree handler
-- whatever its SQL name (fmgr dispatches by prosrc), so the AM is unique-capable.
CREATE SCHEMA b108_handler;
CREATE FUNCTION b108_handler.blhandler(internal) RETURNS index_am_handler AS 'bthandler' LANGUAGE internal;
CREATE ACCESS METHOD b108_named_bt TYPE INDEX HANDLER b108_handler.blhandler;
CREATE OPERATOR CLASS b108_named_int_ops DEFAULT FOR TYPE int4 USING b108_named_bt AS OPERATOR 1 < (int4,int4), OPERATOR 2 <= (int4,int4), OPERATOR 3 = (int4,int4), OPERATOR 4 >= (int4,int4), OPERATOR 5 > (int4,int4), FUNCTION 1 btint4cmp(int4,int4);
CREATE TABLE b108_named_t (id int4);
CREATE UNIQUE INDEX b108_named_u ON b108_named_t USING b108_named_bt (id);
INSERT INTO b108_named_t VALUES (1), (2);
INSERT INTO b108_named_t VALUES (1);
ERROR:  23505: duplicate key value violates unique constraint "b108_named_u"
DETAIL:  Key (id)=(1) already exists.
SCHEMA NAME:  public
TABLE NAME:  b108_named_t
CONSTRAINT NAME:  b108_named_u
SELECT amname, pg_indexam_has_property(oid, 'can_unique') FROM pg_am WHERE amname IN ('b108_bt_alias', 'b108_named_bt') ORDER BY 1;
    amname     | pg_indexam_has_property 
---------------+-------------------------
 b108_bt_alias | t
 b108_named_bt | t
(2 rows)

DROP TABLE b108_named_t;
DROP TABLE b108_child, b108_parent;
DROP ACCESS METHOD b108_named_bt CASCADE;
DROP ACCESS METHOD b108_bt_alias CASCADE;
DROP SCHEMA b108_handler CASCADE;
NOTICE:  00000: drop cascades to function b108_handler.blhandler(internal)
-- regression: an index scan under SERIALIZABLE predicate-locks only
-- the heap tuples it fetches (LIMIT 1 -> one tuple SIREAD lock), never the
-- rest of the page.
CREATE TABLE b108_ser (a int, b int);
INSERT INTO b108_ser SELECT g, g FROM generate_series(1, 20) g;
CREATE INDEX b108_ser_i ON b108_ser (a);
VACUUM ANALYZE b108_ser;
BEGIN ISOLATION LEVEL SERIALIZABLE;
SET LOCAL enable_seqscan = off;
SET LOCAL enable_bitmapscan = off;
SET LOCAL enable_indexonlyscan = off;
SELECT * FROM b108_ser ORDER BY a LIMIT 1;
 a | b 
---+---
 1 | 1
(1 row)

SELECT locktype, relation::regclass AS rel, page, tuple FROM pg_locks WHERE pid = pg_backend_pid() AND mode = 'SIReadLock' ORDER BY 1, 2::text, 3, 4;
 locktype |    rel     | page | tuple 
----------+------------+------+-------
 page     | b108_ser_i |    1 |      
 tuple    | b108_ser   |    0 |     1
(2 rows)

COMMIT;
DROP TABLE b108_ser;
