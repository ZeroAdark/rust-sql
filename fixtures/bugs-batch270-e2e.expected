-- Two-binary differential corpus for the 2026-09-13 bug-inventory batch
-- batch-270-mixed-main0915 (C 18.6 oracle vs pgrust).
\set VERBOSITY verbose
CREATE DATABASE b270e2e TEMPLATE template0 ENCODING 'UTF8';
\c b270e2e
\set VERBOSITY verbose
-- regression: ginbeginscan (ginscan.c:39-45) creates both named scan
-- contexts, so they exist once the cursor is declared, before any FETCH.
CREATE TABLE b270_gt(a int4[]);
INSERT INTO b270_gt SELECT ARRAY[g, g + 1] FROM generate_series(1, 100) g;
CREATE INDEX b270_gt_gin ON b270_gt USING gin (a);
SET enable_seqscan = off;
BEGIN;
DECLARE b270_cur CURSOR FOR SELECT * FROM b270_gt WHERE a @> ARRAY[5];
SELECT name, count(*) FROM pg_backend_memory_contexts WHERE name LIKE 'Gin scan%' GROUP BY 1 ORDER BY 1;
            name            | count 
----------------------------+-------
 Gin scan key context       |     1
 Gin scan temporary context |     1
(2 rows)

FETCH 1 FROM b270_cur;
   a   
-------
 {4,5}
(1 row)

SELECT name, count(*) FROM pg_backend_memory_contexts WHERE name LIKE 'Gin scan%' GROUP BY 1 ORDER BY 1;
            name            | count 
----------------------------+-------
 Gin scan key context       |     1
 Gin scan temporary context |     1
(2 rows)

CLOSE b270_cur;
SELECT name, count(*) FROM pg_backend_memory_contexts WHERE name LIKE 'Gin scan%' GROUP BY 1 ORDER BY 1;
 name | count 
------+-------
(0 rows)

COMMIT;
