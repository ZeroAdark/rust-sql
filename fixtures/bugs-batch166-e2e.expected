-- regression / -p2#1
SELECT to_date(bi('\377'), 'YYYY');
ERROR:  22007: invalid value "ÿ" for "YYYY"
DETAIL:  Value must be an integer.
SELECT to_date(bi('\377oo 2020'), 'Mon YYYY');
ERROR:  22007: invalid value "ÿoo" for "Mon"
DETAIL:  The given value did not match any of the allowed values for this field.
SELECT to_timestamp(bi('x\377'), 'HH24');
ERROR:  22007: invalid value "xÿ" for "HH24"
DETAIL:  Value must be an integer.
