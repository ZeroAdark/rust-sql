        0
(1 row)

SELECT count(*) FROM b142_l OFFSET -1;
ERROR:  2201X: OFFSET must not be negative
SELECT count(*) FROM b142_l OFFSET -1 LIMIT 1;
ERROR:  2201X: OFFSET must not be negative
SELECT count(*) FROM b142_l OFFSET -1 LIMIT 0;
ERROR:  2201X: OFFSET must not be negative
SELECT b, count(*) FROM b142_l GROUP BY b ORDER BY b LIMIT 2 OFFSET -1;
ERROR:  2201X: OFFSET must not be negative
SELECT count(*), sum(b) FROM b142_l LIMIT 0;
