EXPLAIN (FORMAT YAML) SELECT * FROM b119_inf;
          QUERY PLAN           
-------------------------------
 - Plan:                      +
     Node Type: "Seq Scan"    +
     Parallel Aware: false    +
     Async Capable: false     +
