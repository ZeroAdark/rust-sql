CREATE FUNCTION b250_dpl(int) RETURNS int LANGUAGE plpgsql
  SET debug_print_parse = on SET debug_print_rewritten = on
  AS $$ DECLARE r int; BEGIN SELECT $1 + 2 INTO r; RETURN r; END $$;
