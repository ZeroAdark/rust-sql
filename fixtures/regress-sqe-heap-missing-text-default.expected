\set VERBOSITY verbose
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_am WHERE amname = 'pgrcolumnar2') THEN CREATE ACCESS METHOD pgrcolumnar2 TYPE TABLE HANDLER heap_tableam_handler; END IF; END $$;
-- Lane S: sqe over heap, a text column added with a default after rows exist
CREATE TABLE r1 (a int4);
INSERT INTO r1 VALUES (1), (2), (3);
ALTER TABLE r1 ADD COLUMN g text COLLATE "C" DEFAULT 'dflt';
INSERT INTO r1 VALUES (4, 'new');
SET max_parallel_workers_per_gather = 0;
SET pgrust.sqe_heap = off;
SELECT g, count(*) FROM r1 GROUP BY g ORDER BY g;
  g   | count 
------+-------
 dflt |     3
 new  |     1
(2 rows)

SET pgrust.sqe_heap = on;
SELECT g, count(*) FROM r1 GROUP BY g ORDER BY g;
  g   | count 
------+-------
 dflt |     3
 new  |     1
(2 rows)

SELECT g, count(*) FROM r1 GROUP BY g ORDER BY 2 DESC LIMIT 1;
  g   | count 
------+-------
 dflt |     3
(1 row)

SELECT count(*) FROM r1 WHERE g LIKE 'd%';
 count 
-------
     3
(1 row)

