-- Differential fixture for the 2026-09-13 audit bug batch 280 (planner:
-- histogram endpoint probes over compressed index datums, commuted KNN
-- ORDER BY opfuncid resolution, join-alias flattening before subquery
-- pull-up). Run via scripts/bugs-batch280-e2e.sh against the frozen expected
-- captured from C PostgreSQL 18.6 (the rangetypes block is hand-verified,
-- see the comment there).
\set VERBOSITY verbose
\pset pager off
-- regression: a btree index compresses text/bytea/numeric entries
-- past TOAST_INDEX_TARGET; the actual-endpoint probe hands that image to
-- convert_to_scalar, which must detoast it like TextDatumGetCString.
CREATE TABLE b280_ct(t text, b bytea, n numeric);
INSERT INTO b280_ct
  SELECT repeat(chr(97 + (i % 26)), 600) || i,
         (repeat(chr(97 + (i % 26)), 600) || i)::bytea,
         (repeat('1', 1200) || i)::numeric
  FROM generate_series(1, 2000) i;
CREATE INDEX b280_ct_t ON b280_ct(t);
CREATE INDEX b280_ct_b ON b280_ct(b);
CREATE INDEX b280_ct_n ON b280_ct(n);
ANALYZE b280_ct;
SELECT count(*) FROM b280_ct WHERE t < repeat('a', 600) || '1015';
 count 
-------
     1
(1 row)

SELECT count(*) FROM b280_ct WHERE t > repeat('z', 600) || '98';
 count 
-------
     1
(1 row)

SELECT count(*) FROM b280_ct WHERE b < (repeat('a', 600) || '1015')::bytea;
 count 
-------
     1
(1 row)

SELECT count(*) FROM b280_ct WHERE b > (repeat('z', 600) || '98')::bytea;
 count 
-------
     1
(1 row)

SELECT count(*) FROM b280_ct WHERE n < (repeat('1', 1200) || '1001')::numeric;
 count 
-------
  1000
(1 row)

SELECT count(*) FROM b280_ct WHERE n > (repeat('1', 1200) || '9999')::numeric;
 count 
-------
     0
(1 row)

DROP TABLE b280_ct;
-- regression: a commuted KNN ORDER BY (constant on the left) keeps
-- an opfuncid-less OpExpr in indexorderbyorig; setrefs resolves it.
CREATE TABLE b280_pts(p point, k int);
INSERT INTO b280_pts SELECT point(i, i), i FROM generate_series(1, 100) i;
CREATE INDEX b280_pts_p ON b280_pts USING gist(p);
SET enable_seqscan = off;
SELECT k FROM b280_pts ORDER BY '(0,0)'::point <-> p LIMIT 2;
 k 
---
 1
 2
(2 rows)

SELECT * FROM b280_pts ORDER BY '(0,0)'::point <-> p LIMIT 2;
   p   | k 
-------+---
 (1,1) | 1
 (2,2) | 2
(2 rows)

SELECT k FROM b280_pts ORDER BY p <-> '(0,0)'::point LIMIT 2;
 k 
---
 1
 2
(2 rows)

RESET enable_seqscan;
DROP TABLE b280_pts;
-- regression: a JOIN USING over numeric columns of different
-- typmods yields a join-alias Var whose expansion is a coercion; the pulled-up
-- subquery's targetlist is flattened first so the FULL JOIN condition gets
-- its PlaceHolderVar (C prepjointree.c:1431).
CREATE TABLE b280_fj(a numeric);
INSERT INTO b280_fj VALUES (1), (2);
SELECT * FROM (SELECT a FROM (VALUES (1.00::numeric(5,2))) v1(a) JOIN (VALUES (1.000::numeric(7,3))) v2(a) USING (a)) s
  FULL JOIN b280_fj ON b280_fj.a = s.a ORDER BY b280_fj.a;
  a   | a 
------+---
 1.00 | 1
      | 2
(2 rows)

SELECT * FROM (SELECT a FROM (SELECT 1.00::numeric(5,2) AS a) v1 JOIN (SELECT 1.000::numeric(7,3) AS a) v2 USING (a)) s
  FULL JOIN b280_fj ON b280_fj.a = s.a ORDER BY b280_fj.a;
  a   | a 
------+---
 1.00 | 1
      | 2
(2 rows)

SELECT * FROM (SELECT a, 1 AS k FROM (SELECT 1.00::numeric(5,2) AS a) v1 JOIN (SELECT 1.000::numeric(7,3) AS a) v2 USING (a)) s
  FULL JOIN b280_fj ON b280_fj.a = s.a AND s.k = 1 ORDER BY b280_fj.a;
  a   | k | a 
------+---+---
 1.00 | 1 | 1
      |   | 2
(2 rows)

SELECT * FROM b280_fj LEFT JOIN (SELECT a FROM (SELECT 1.00::numeric(5,2) AS a) v1 JOIN (SELECT 1.000::numeric(7,3) AS a) v2 USING (a)) s
  ON b280_fj.a = s.a ORDER BY b280_fj.a;
 a |  a   
---+------
 1 | 1.00
 2 |     
(2 rows)

DROP TABLE b280_fj;
-- regression (pg-also-bug, UPSTREAM-BUGS.md): C 18.6 raises XX000
-- "no relation entry for relid 1" when the range-containment simplifier costs
-- an elemExpr holding a ScalarArrayOpExpr over an array column during
-- targetlist preprocessing (rangetypes.c find_simplified_clause ->
-- cost_qual_eval_node(root) -> estimate_array_length -> examine_variable
-- before the base rels exist). pgrust costs without the root and returns the
-- rows; this block's expected output is hand-verified, not captured from C.
CREATE TABLE b280_ta(arr int[]);
INSERT INTO b280_ta VALUES ('{1,2}'), ('{3}');
SELECT int4range(1,10) @> (CASE WHEN 1 = ANY(arr) THEN 1 ELSE 2 END) FROM b280_ta ORDER BY 1;
 ?column? 
----------
 t
 t
(2 rows)

SELECT int4range(1,10) @> (1 = ANY(arr))::int FROM b280_ta ORDER BY 1;
 ?column? 
----------
 f
 t
(2 rows)

SELECT * FROM b280_ta WHERE int4range(1,10) @> (1 = ANY(arr))::int;
  arr  
-------
 {1,2}
(1 row)

DROP TABLE b280_ta;
