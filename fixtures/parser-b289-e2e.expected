-- bugs/batch-289-backend-parser-parse_utilcmd: expected captured from C 18.6.
\set VERBOSITY verbose
-- regression: USING INDEX folds the predicate like
-- RelationGetIndexPredicate; a predicate that folds to TRUE is not partial.
create table b289 (a int);
create unique index b289_i1 on b289 (a) where 1 = 1;
alter table b289 add constraint b289_c1 unique using index b289_i1;
NOTICE:  00000: ALTER TABLE / ADD CONSTRAINT USING INDEX will rename index "b289_i1" to "b289_c1"
create unique index b289_i2 on b289 (a) where (1 = 1) and (2 = 2);
alter table b289 add constraint b289_c2 unique using index b289_i2;
NOTICE:  00000: ALTER TABLE / ADD CONSTRAINT USING INDEX will rename index "b289_i2" to "b289_c2"
create unique index b289_i3 on b289 (a) where a in (1, 2, 3) or true;
alter table b289 add constraint b289_c3 primary key using index b289_i3;
NOTICE:  00000: ALTER TABLE / ADD CONSTRAINT USING INDEX will rename index "b289_i3" to "b289_c3"
create unique index b289_i4 on b289 (a) where a > 0;
alter table b289 add constraint b289_c4 unique using index b289_i4;
ERROR:  42809: "b289_i4" is a partial index
LINE 1: alter table b289 add constraint b289_c4 unique using index b...
                             ^
DETAIL:  Cannot create a primary key or unique constraint using such an index.
create unique index b289_i5 on b289 (a) where a is not null or a is null;
alter table b289 add constraint b289_c5 unique using index b289_i5;
ERROR:  42809: "b289_i5" is a partial index
LINE 1: alter table b289 add constraint b289_c5 unique using index b...
                             ^
DETAIL:  Cannot create a primary key or unique constraint using such an index.
select conname, contype, conindid::regclass from pg_constraint where conrelid = 'b289'::regclass order by conname;
     conname     | contype | conindid 
-----------------+---------+----------
 b289_a_not_null | n       | -
 b289_c1         | u       | b289_c1
 b289_c2         | u       | b289_c2
 b289_c3         | p       | b289_c3
(4 rows)

select indexname, indexdef from pg_indexes where tablename = 'b289' order by indexname;
 indexname |                                               indexdef                                                
-----------+-------------------------------------------------------------------------------------------------------
 b289_c1   | CREATE UNIQUE INDEX b289_c1 ON public.b289 USING btree (a) WHERE (1 = 1)
 b289_c2   | CREATE UNIQUE INDEX b289_c2 ON public.b289 USING btree (a) WHERE ((1 = 1) AND (2 = 2))
 b289_c3   | CREATE UNIQUE INDEX b289_c3 ON public.b289 USING btree (a) WHERE ((a = ANY (ARRAY[1, 2, 3])) OR true)
 b289_i4   | CREATE UNIQUE INDEX b289_i4 ON public.b289 USING btree (a) WHERE (a > 0)
 b289_i5   | CREATE UNIQUE INDEX b289_i5 ON public.b289 USING btree (a) WHERE ((a IS NOT NULL) OR (a IS NULL))
(5 rows)

select attname, attnotnull from pg_attribute where attrelid = 'b289'::regclass and attnum > 0;
 attname | attnotnull 
---------+------------
 a       | t
(1 row)

-- regression: DeconstructQualifiedName errors run outside
-- typenameType's position callback: no cursor for these, cursor for the rest.
create type b289_shell;
create table b289_t (a a.b.c.d);
ERROR:  42601: improper qualified name (too many dotted names): a.b.c.d
create table b289_t (a a.b.c);
ERROR:  0A000: cross-database references are not implemented: a.b.c
create table b289_t (a a.b.c.d generated always as identity);
ERROR:  42601: improper qualified name (too many dotted names): a.b.c.d
create table b289_t (a int, b int generated always as identity, c nosuchtype);
ERROR:  42704: type "nosuchtype" does not exist
LINE 1: ...9_t (a int, b int generated always as identity, c nosuchtype...
                                                             ^
create table b289_t of a.b.c.d;
ERROR:  42601: improper qualified name (too many dotted names): a.b.c.d
create table b289_t of nosuchtype;
ERROR:  42704: type "nosuchtype" does not exist
LINE 1: create table b289_t of nosuchtype;
                               ^
create table b289_t of nosuch.foo;
ERROR:  3F000: schema "nosuch" does not exist
LINE 1: create table b289_t of nosuch.foo;
                               ^
create table b289_t of b289_shell;
ERROR:  42704: type "b289_shell" is only a shell
LINE 1: create table b289_t of b289_shell;
                               ^
create table b289_t (a nosuch.int4);
ERROR:  3F000: schema "nosuch" does not exist
LINE 1: create table b289_t (a nosuch.int4);
                               ^
create table b289_t (a nosuchtype);
ERROR:  42704: type "nosuchtype" does not exist
LINE 1: create table b289_t (a nosuchtype);
                               ^
create table b289_t (a int4(3));
ERROR:  42601: type modifier is not allowed for type "int4"
LINE 1: create table b289_t (a int4(3));
                               ^
create table b289_t (a b289_shell);
ERROR:  42704: type "b289_shell" is only a shell
LINE 1: create table b289_t (a b289_shell);
                               ^
alter table b289 add column b a.b.c.d;
ERROR:  42601: improper qualified name (too many dotted names): a.b.c.d
alter table b289 add column b a.b.c;
ERROR:  0A000: cross-database references are not implemented: a.b.c
alter table b289 add column b nosuchtype;
ERROR:  42704: type "nosuchtype" does not exist
LINE 1: alter table b289 add column b nosuchtype;
                                      ^
alter table b289 add column b nosuch.int4;
ERROR:  3F000: schema "nosuch" does not exist
LINE 1: alter table b289 add column b nosuch.int4;
                                      ^
alter table b289 add column b b289_shell;
ERROR:  42704: type "b289_shell" is only a shell
LINE 1: alter table b289 add column b b289_shell;
                                      ^
alter table b289 add column b int4(3);
ERROR:  42601: type modifier is not allowed for type "int4"
LINE 1: alter table b289 add column b int4(3);
                                      ^
-- regression: pts_error_callback adds CONTEXT only; the inner
-- scanner's cursor is kept as-is (parse_type.c:719).
set standard_conforming_strings = off;
select to_regtype($$text('\n')$$);
WARNING:  22P06: nonstandard use of escape in a string literal
LINE 1: select to_regtype($$text('\n')$$);
             ^
HINT:  Use the escape string syntax for escapes, e.g., E'\r\n'.
ERROR:  42601: type modifier is not allowed for type "text"
select to_regtype($$"text"('\n')$$);
WARNING:  22P06: nonstandard use of escape in a string literal
LINE 1: select to_regtype($$"text"('\n')$$);
               ^
HINT:  Use the escape string syntax for escapes, e.g., E'\r\n'.
ERROR:  42601: type modifier is not allowed for type "text"
select to_regtype($$bit('\\')$$);
WARNING:  22P06: nonstandard use of \\ in a string literal
LINE 1: select to_regtype($$bit('\\')$$);
            ^
HINT:  Use the escape string syntax for backslashes, e.g., E'\\'.
ERROR:  22P02: invalid input syntax for type integer: "\"
select to_regtype('varchar(''\n'')');
WARNING:  22P06: nonstandard use of escape in a string literal
LINE 1: select to_regtype('varchar(''\n'')');
                          ^
HINT:  Use the escape string syntax for escapes, e.g., E'\r\n'.
ERROR:  42601: syntax error at or near "'
'"
LINE 1: select to_regtype('varchar(''\n'')');
                ^
CONTEXT:  invalid type name "varchar('
')"
select to_regtype('varchar(''\\''  ,  ''\\'')');
WARNING:  22P06: nonstandard use of \\ in a string literal
LINE 1: select to_regtype('varchar(''\\''  ,  ''\\'')');
                          ^
HINT:  Use the escape string syntax for backslashes, e.g., E'\\'.
WARNING:  22P06: nonstandard use of \' in a string literal
LINE 1: select to_regtype('varchar(''\\''  ,  ''\\'')');
                ^
HINT:  Use '' to write quotes in strings, or use the escape string syntax (E'...').
ERROR:  42601: syntax error at or near "'\'  ,  '"
LINE 1: select to_regtype('varchar(''\\''  ,  ''\\'')');
                ^
CONTEXT:  invalid type name "varchar('\'  ,  '\')"
reset standard_conforming_strings;
select to_regtype('varchar(E''\n'')');
ERROR:  42601: syntax error at or near "E'\n'"
LINE 1: select to_regtype('varchar(E''\n'')');
                ^
CONTEXT:  invalid type name "varchar(E'\n')"
-- regression: the position callback spans the TYPENAMENSP lookup
-- (parse_type.c:177-187), so a lock timeout inside it is positioned.
\setenv PGHOST :HOST
\setenv PGPORT :PORT
\setenv PGDATABASE :DBNAME
\setenv PGUSER :USER
\! "${PGINSTALL:-$(dirname "$(command -v psql)")}/psql" -X -q -c "begin; lock table pg_catalog.pg_type in access exclusive mode; select pg_sleep(4);" >/dev/null 2>&1 &
select pg_sleep(1.5);
 pg_sleep 
----------
 
(1 row)

set lock_timeout = '200ms';
select 1::pg_catalog.b289_nosuch_type;
ERROR:  55P03: canceling statement due to lock timeout
LINE 1: select 1::pg_catalog.b289_nosuch_type;
                  ^
select 1::b289_nosuch_type;
ERROR:  55P03: canceling statement due to lock timeout
create function b289_f(pg_catalog.b289_nosuch_type) returns int language sql as 'select 1';
ERROR:  55P03: canceling statement due to lock timeout
LINE 1: create function b289_f(pg_catalog.b289_nosuch_type) returns ...
                               ^
reset lock_timeout;
select pg_sleep(3);
 pg_sleep 
----------
 
(1 row)

drop table b289;
drop type b289_shell;
