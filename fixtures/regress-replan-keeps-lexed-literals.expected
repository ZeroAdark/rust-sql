SET escape_string_warning = off;
CREATE TABLE relex_t (x int);
CREATE FUNCTION relex_f() RETURNS int LANGUAGE plpgsql
  AS $$ BEGIN RETURN length('a\nb') + (SELECT count(*) FROM relex_t)::int; END $$;
CREATE FUNCTION relex_g() RETURNS text LANGUAGE plpgsql
  AS $$ DECLARE r text; BEGIN SELECT 'C:\temp\new' || count(*) INTO r FROM relex_t; RETURN r; END $$;
-- first use under standard_conforming_strings = on: 'a\nb' is four characters
SET standard_conforming_strings = on;
SELECT relex_f() AS f_first, relex_g() AS g_first;
 f_first |   g_first    
---------+--------------
       4 | C:\temp\new0
(1 row)

-- the setting changes; the cached plans keep the meaning they were parsed with
SET standard_conforming_strings = off;
SELECT relex_f() AS f_no_invalidation, relex_g() AS g_no_invalidation;
 f_no_invalidation | g_no_invalidation 
-------------------+-------------------
                 4 | C:\temp\new0
(1 row)

-- any invalidation of the plans (here ANALYZE of the table they read)
ANALYZE relex_t;
SELECT relex_f() AS f_after_analyze, relex_g() AS g_after_analyze;
 f_after_analyze | g_after_analyze 
-----------------+-----------------
               4 | C:\temp\new0
(1 row)

-- the other direction: first used under off, replanned under on
DISCARD PLANS;
SET standard_conforming_strings = off;
CREATE FUNCTION relex_h() RETURNS int LANGUAGE plpgsql
  AS $$ BEGIN RETURN length('a\nb') + (SELECT count(*) FROM relex_t)::int; END $$;
SELECT relex_h() AS h_first;
 h_first 
---------
       3
(1 row)

SET standard_conforming_strings = on;
ALTER TABLE relex_t ADD COLUMN y int;
SELECT relex_h() AS h_after_alter;
 h_after_alter 
---------------
             3
(1 row)

