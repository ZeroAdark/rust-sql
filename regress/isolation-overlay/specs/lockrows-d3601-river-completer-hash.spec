# D3601 (4) - (7): River's job completer (JobSetStateIfRunningMany) over 400 jobs, a batch of five. PostgreSQL 18.6
# hashes the CTE of unnest columns under the claim job_to_update (LockRows -> Hash Join over river_job's scan) and the
# claim's store under both UPDATE CTEs (Hash Joins on the outer-first path), the second one's target scan filtered by a
# hashed NOT IN over the first one's store. Against a concurrent change of a listed job (READ COMMITTED) the claim's
# lock waits, finds the version its snapshot read updated and rechecks the newest one under EvalPlanQual over the stored
# unnest row; each UPDATE then finds its snapshot's version updated and rechecks the newest one over the claim's stored
# row. A running job whose metadata changed is finished over its newest version; one finished concurrently is claimed by
# its metadata merge, yet neither UPDATE writes it and the final SELECT shows the snapshot's version; a deleted one is
# gone; a concurrent cancel attempt cancels the retried job; a finished job's merge lands over its newest version, and
# none lands when it runs again. The expected output is PostgreSQL 18.6's.
setup
{
  CREATE TYPE river_job_state AS ENUM ('available', 'cancelled', 'completed', 'discarded', 'pending', 'retryable', 'running', 'scheduled');
  CREATE FUNCTION river_job_state_in_bitmask(bitmask bit(8), state river_job_state) RETURNS boolean LANGUAGE SQL IMMUTABLE AS $$ SELECT CASE state WHEN 'available' THEN get_bit(bitmask, 7) WHEN 'cancelled' THEN get_bit(bitmask, 6) WHEN 'completed' THEN get_bit(bitmask, 5) WHEN 'discarded' THEN get_bit(bitmask, 4) WHEN 'pending' THEN get_bit(bitmask, 3) WHEN 'retryable' THEN get_bit(bitmask, 2) WHEN 'running' THEN get_bit(bitmask, 1) WHEN 'scheduled' THEN get_bit(bitmask, 0) ELSE 0 END = 1 $$;
  CREATE TABLE river_job (id bigserial PRIMARY KEY, state river_job_state NOT NULL DEFAULT 'available', attempt smallint NOT NULL DEFAULT 0, max_attempts smallint NOT NULL DEFAULT 25, attempted_at timestamptz, created_at timestamptz NOT NULL DEFAULT '2026-01-01', finalized_at timestamptz, scheduled_at timestamptz NOT NULL DEFAULT '2026-01-01', priority smallint NOT NULL DEFAULT 1, args jsonb NOT NULL DEFAULT jsonb_build_object(), attempted_by text[], errors jsonb[], kind text NOT NULL, metadata jsonb NOT NULL DEFAULT jsonb_build_object(), queue text NOT NULL DEFAULT 'default', tags varchar(255)[] NOT NULL DEFAULT ARRAY[]::varchar(255)[], unique_key bytea, unique_states bit(8));
  CREATE INDEX river_job_prioritized_fetching_index ON river_job (state, queue, priority, scheduled_at, id);
  CREATE UNIQUE INDEX river_job_unique_idx ON river_job (unique_key) WHERE unique_key IS NOT NULL AND unique_states IS NOT NULL AND river_job_state_in_bitmask(unique_states, state);
  INSERT INTO river_job (state, attempt, attempted_at, finalized_at, scheduled_at, priority, kind, queue, unique_key, unique_states) SELECT (ARRAY['available', 'scheduled', 'retryable', 'running', 'completed', 'scheduled', 'discarded', 'cancelled'])[g % 8 + 1]::river_job_state, g % 3, CASE WHEN g % 8 = 3 THEN timestamptz '2026-01-01' + g * interval '1 second' END, CASE WHEN g % 8 IN (4, 6, 7) THEN timestamptz '2026-01-01' + g * interval '1 minute' END, timestamptz '2026-01-01' + (g % 50) * interval '1 hour', g % 4 + 1, 'k' || (g % 3), CASE WHEN g % 2 = 0 THEN 'default' ELSE 'mail' END, CASE WHEN g % 5 = 0 THEN decode(lpad(to_hex(g), 4, '0'), 'hex') END, CASE WHEN g % 5 = 0 THEN B'11110101' END FROM generate_series(1, 400) g;
  ANALYZE river_job;
}
teardown { DROP TABLE river_job; DROP FUNCTION river_job_state_in_bitmask(bit(8), river_job_state); DROP TYPE river_job_state; }

