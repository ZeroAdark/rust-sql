        Hash Cond: (s.k = ct.k)             
        ->  Subquery Scan on s              
              Filter: (s.w <> 3)            
              ->  Seq Scan on cs            
        ->  Hash                            
              ->  Seq Scan on ct            
                    Filter: ((id % 150) = 0)
(9 rows)

