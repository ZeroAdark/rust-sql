step s3pb: EXPLAIN (COSTS OFF) UPDATE ot SET x = x + os.id FROM os WHERE os.id BETWEEN ot.k - 1 AND ot.k AND os.w IN (1, 2) AND ot.id <= 40;
QUERY PLAN                                                      
----------------------------------------------------------------
Update on ot                                                    
  ->  Nested Loop                                               
        Join Filter: ((os.id <= ot.k) AND (os.id >= (ot.k - 1)))
        ->  Seq Scan on ot                                      
              Filter: (id <= 40)                                
        ->  Materialize                                         
              ->  Seq Scan on os                                
                    Filter: (w = ANY ('{1,2}'::integer[]))      
(8 rows)

step s3pd: EXPLAIN (COSTS OFF) DELETE FROM ot USING os WHERE os.id BETWEEN ot.k - 1 AND ot.k AND os.w IN (1, 2) AND ot.x = 0 AND ot.id <= 40;
QUERY PLAN                                                      
----------------------------------------------------------------
Delete on ot                                                    
  ->  Nested Loop                                               
        Join Filter: ((os.id <= ot.k) AND (os.id >= (ot.k - 1)))
        ->  Bitmap Heap Scan on ot                              
              Recheck Cond: (id <= 40)                          
              Filter: (x = 0)                                   
              ->  Bitmap Index Scan on ot_pkey                  
                    Index Cond: (id <= 40)                      
        ->  Materialize                                         
              ->  Seq Scan on os                                
                    Filter: (w = ANY ('{1,2}'::integer[]))      
(11 rows)

