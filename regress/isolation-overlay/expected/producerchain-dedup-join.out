                          Filter: ((id % 100) = 0)        
                    ->  Index Scan using bc_pkey on bc    
                          Index Cond: (id = b2.id)        
                          Filter: (region = 'south'::text)
        ->  Index Scan using bt_pkey on bt                
              Index Cond: (id = bc.id)                    
