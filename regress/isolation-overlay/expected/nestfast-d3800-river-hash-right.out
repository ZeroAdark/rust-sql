                            Join Filter: (rh_job_3.id <> jobs_with_rownum.id)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
                            ->  Bitmap Heap Scan on rh_job rh_job_3                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
                                  Recheck Cond: ((unique_key IS NOT NULL) AND (unique_states IS NOT NULL) AND (CASE state WHEN 'available'::rh_state THEN get_bit(unique_states, 7) WHEN 'cancelled'::rh_state THEN get_bit(unique_states, 6) WHEN 'completed'::rh_state THEN get_bit(unique_states, 5) WHEN 'discarded'::rh_state THEN get_bit(unique_states, 4) WHEN 'pending'::rh_state THEN get_bit(unique_states, 3) WHEN 'retryable'::rh_state THEN get_bit(unique_states, 2) WHEN 'running'::rh_state THEN get_bit(unique_states, 1) WHEN 'scheduled'::rh_state THEN get_bit(unique_states, 0) ELSE 0 END = 1))
                                  ->  Bitmap Index Scan on rh_job_unique_idx                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
                                        Index Cond: (unique_key IS NOT NULL)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
