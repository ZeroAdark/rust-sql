                            Filter: ((state = ANY ('{retryable,scheduled}'::rh_state[])) AND (scheduled_at <= 'Fri Jan 02 00:00:00 2026 PST'::timestamp with time zone))                                                                                                                                                                                                                                                                                                                                                                                                                                              
  CTE jobs_with_rownum                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
    ->  WindowAgg                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
          Window: w1 AS (PARTITION BY jobs_to_schedule.unique_key ORDER BY jobs_to_schedule.priority, jobs_to_schedule.scheduled_at, jobs_to_schedule.id ROWS UNBOUNDED PRECEDING)                                                                                                                                                                                                                                                                                                                                                                                                                                    
          ->  Sort                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                Sort Key: jobs_to_schedule.unique_key, jobs_to_schedule.priority, jobs_to_schedule.scheduled_at, jobs_to_schedule.id                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
                ->  CTE Scan on jobs_to_schedule                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
  CTE updated_jobs                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
    ->  Update on rh_job rh_job_2                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
          ->  Nested Loop                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
                ->  Hash Right Join                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
                      Hash Cond: (rh_job_3.unique_key = job.unique_key)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                      ->  Hash Join                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
